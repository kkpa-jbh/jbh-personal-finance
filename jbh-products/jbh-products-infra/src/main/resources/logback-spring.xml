<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

  <!-- Define properties -->
  <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{trackingId:-NO-TRACKING}] [%X{accountId:-}] [%X{userId:-}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="FILE">
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{trackingId:-NO-TRACKING}] [%X{accountId:-}] [%X{userId:-}] [%X{transactionId:-}] [%X{module:-}] %logger{36} -
        %msg%n
      </pattern>
    </encoder>
    <file>${LOG_FILE}</file>

    <!-- Rolling Policy -->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- Console Appender with MDC support -->
  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="JSON_FILE">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"application":"jbh-personal-finance"}</customFields>
      <includeContext>true</includeContext>
      <includeMdc>true</includeMdc>
    </encoder>
    <file>/tmp/jbh-personal-finance-json.log</file>

    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>/tmp/jbh-personal-finance-json.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- File Appender with MDC support and rolling policy -->
  <appender class="ch.qos.logback.classic.AsyncAppender" name="ASYNC_FILE">
    <appender-ref ref="FILE"/>
    <discardingThreshold>80</discardingThreshold>
    <includeCallerData>false</includeCallerData>
    <maxFlushTime>1000</maxFlushTime>
    <neverBlock>false</neverBlock>
    <queueSize>512</queueSize>
  </appender>

  <!-- JSON Appender for structured logging (optional) -->
  <logger level="DEBUG" name="com.jbh.products.domain"/>

  <!-- Async Appender for performance -->
  <logger level="DEBUG" name="com.jbh.products"/>

  <!-- Logger configurations -->

  <!-- Domain layer - business logic -->
  <logger level="INFO" name="com.jbh.products.infra"/>

  <!-- Application layer - use cases -->
  <logger level="INFO" name="io.quarkus"/>

  <!-- Infrastructure layer -->
  <logger level="WARN" name="org.hibernate"/>

  <!-- Quarkus framework logs -->
  <logger level="DEBUG" name="org.hibernate.SQL"/>

  <!-- Database logs -->
  <logger level="TRACE" name="org.hibernate.type.descriptor.sql.BasicBinder"/>
  <logger level="DEBUG" name="org.springframework.transaction"/>
  <logger level="INFO" name="io.quarkus.http.access-log"/>

  <!-- Transaction logs -->
  <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>

  <!-- HTTP requests -->
  <property name="LOG_FILE" value="${LOG_FILE:-/tmp/jbh-personal-finance.log}"/>

  <!-- Profile-based configuration -->
  <root level="${LOG_LEVEL}">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ASYNC_FILE"/>
  </root>

  <springProfile name="dev,local">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </root>
  </springProfile>

  <springProfile name="test">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <!-- Default configuration -->
  <springProfile name="prod,production">
    <root level="INFO">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="JSON_FILE"/>
    </root>
  </springProfile>

</configuration>