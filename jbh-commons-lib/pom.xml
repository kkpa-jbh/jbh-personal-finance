<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <artifactId>jbh-commons-lib</artifactId>

  <build>
    <plugins>

      <!-- Enable JUnit 5 -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

    </plugins>
  </build>

  <dependencies>

    <!-- Modern testing -->
    <dependency>
      <artifactId>junit-jupiter</artifactId>
      <groupId>org.junit.jupiter</groupId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <artifactId>archunit-junit5</artifactId>
      <groupId>com.tngtech.archunit</groupId>
      <scope>test</scope>
      <version>1.3.0</version>
    </dependency>

    <!-- Jackson for JSON processing -->
    <dependency>
      <artifactId>jackson-annotations</artifactId>
      <groupId>com.fasterxml.jackson.core</groupId>
    </dependency>

    <dependency>
      <artifactId>jackson-databind</artifactId>
      <groupId>com.fasterxml.jackson.core</groupId>
    </dependency>


  </dependencies>
  <dependencyManagement>
    <dependencies>
      <!-- Only allow whitelisted technical libs -->
    </dependencies>
  </dependencyManagement>
  <description>
    Shared technical utilities for the jbh modular monolith.
    Contains no business or domain logic.
  </description>

  <groupId>com.jbh</groupId>

  <modelVersion>4.0.0</modelVersion>

  <name>jbh-commons-lib</name>

  <packaging>jar</packaging>

  <parent>
    <artifactId>jbh-personal-finance</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>


</project>
