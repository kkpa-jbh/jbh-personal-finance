# Env vars for jbh-personal-finance. Copy this file to .env and fill it.
# Quarkus reads .env from the folder where you start the app.
# Never commit .env. Values here are fake.

# Database (required in prod; dev and test default to postgres/postgres)
DATABASE_URL=jdbc:postgresql://localhost:5432/jbh_finance
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# Consul and the gateway
CONSUL_ENABLED=true
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_PREFER_IP=true
CONSUL_HEALTH_CHECK_HOST=
JBH_GATEWAY_URL=http://localhost:8080
JBH_FRONTEND_URL=http://localhost:8100

# Email (Gmail SMTP). GMAIL_APP_PASSWORD is required in prod.
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=465
GMAIL_USERNAME=change-me@gmail.com
GMAIL_APP_PASSWORD=change-me
GMAIL_FROM=change-me@gmail.com

# Bank statement import: OCR, then an LLM
# STATEMENT_TEXT_SOURCE: azure (default, OCR) or pdfbox (PDF text, no OCR)
STATEMENT_TEXT_SOURCE=azure
AZURE_DI_ENDPOINT=https://change-me.cognitiveservices.azure.com
AZURE_DI_API_KEY=change-me
AZURE_DI_PAGES_PER_REQUEST=2
# STATEMENT_LLM: openrouter (default) or gemini
STATEMENT_LLM=openrouter
OPENROUTER_API_KEY=change-me
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-flash-latest
JEV_API_KEY=change-me

# Dev only: compare LLM providers and write reports
STATEMENT_LLM_COMPARE=false
STATEMENT_LLM_COMPARE_DIR=target/llm-compare
OLLAMA_API_KEY=
