<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>jbh-notification</artifactId>
  <build>

    <pluginManagement>
      <plugins>
        <!-- Compiler Plugin - EXTENDS parent configuration -->
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <groupId>org.apache.maven.plugins</groupId>
        </plugin>

        <!-- Quarkus Plugin - EXTENDS parent configuration -->
        <plugin>
          <artifactId>quarkus-maven-plugin</artifactId>
          <configuration>
            <!-- INHERITS parent configuration (debug, suspend, executions) -->
            <!-- ADDS Module A specific configuration -->
            <environmentVariables>
              <MODULE_NAME>module-a</MODULE_NAME>
            </environmentVariables>
            <!-- Module A specific Quarkus settings -->
            <jvmArgs>-XX:+UseG1GC</jvmArgs>
          </configuration>
          <!-- Version and base config inherited from parent -->
          <groupId>io.quarkus.platform</groupId>
        </plugin>

        <!-- Maven Enforcer Plugin for dependency management -->
        <plugin>
          <artifactId>maven-enforcer-plugin</artifactId>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven-enforcer-plugin.version}</version>
          <configuration>
            <rules>
              <!-- Ensure minimum Maven version -->
              <requireMavenVersion>
                <version>[3.8.1,)</version>
                <message>Maven 3.8.1 or higher is required for this project</message>
              </requireMavenVersion>
              
              <!-- Ensure minimum Java version -->
              <requireJavaVersion>
                <version>[21,)</version>
                <message>Java 21 or higher is required for this project</message>
              </requireJavaVersion>
              
              <!-- Prevent dependency convergence issues -->
              <dependencyConvergence />
              
              <!-- Ensure no duplicate dependencies -->
              <banDuplicatePomDependencyVersions />
              
              <!-- Ban specific vulnerable dependencies (example) -->
              <bannedDependencies>
                <excludes>
                  <exclude>log4j:log4j:*:jar:compile</exclude>
                  <exclude>commons-logging:commons-logging:*:jar:compile</exclude>
                </excludes>
                <message>These dependencies are banned due to security vulnerabilities or conflicts</message>
              </bannedDependencies>
            </rules>
          </configuration>
        </plugin>
      </plugins>

    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

      <plugin>
        <artifactId>quarkus-maven-plugin</artifactId>
        <groupId>io.quarkus.platform</groupId>
      </plugin>

      <!-- Jandex Plugin for CDI Bean Discovery -->
      <plugin>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>jandex</goal>
            </goals>
            <id>make-index</id>
          </execution>
        </executions>
        <groupId>io.smallrye</groupId>
      </plugin>

      <!-- Maven Enforcer Plugin - runs during validate phase -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <dependencies>
    <dependency>
      <artifactId>quarkus-arc</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

  </dependencies>
  <modelVersion>4.0.0</modelVersion>
  <modules>
    <module>jbh-notification-infra</module>
  </modules>

  <packaging>pom</packaging>

  <parent>
    <artifactId>jbh-personal-finance</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <!-- Common dependencies for Module A and its children -->
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

</project>