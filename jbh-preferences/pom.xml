<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>jbh-preferences</artifactId>

  <build>

    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <artifactId>lombok</artifactId>
                <groupId>org.projectlombok</groupId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
        </plugin>

        <plugin>
          <artifactId>jacoco-maven-plugin</artifactId>
          <groupId>org.jacoco</groupId>
          <version>${maven.jacoco.plugin.version}</version>
        </plugin>

        <plugin>
          <artifactId>maven-enforcer-plugin</artifactId>
          <configuration>
            <rules>
              <banDuplicatePomDependencyVersions/>

              <bannedDependencies>
                <excludes>
                  <exclude>log4j:log4j:*:jar:compile</exclude>
                  <exclude>commons-logging:commons-logging:*:jar:compile</exclude>
                </excludes>
                <message>These dependencies are banned due to security vulnerabilities or conflicts</message>
              </bannedDependencies>

              <dependencyConvergence/>

              <requireJavaVersion>
                <message>Java 21 or higher is required for this project</message>
                <version>[21,)</version>
              </requireJavaVersion>

              <requireMavenVersion>
                <message>Maven 3.8.1 or higher is required for this project</message>
                <version>[3.8.1,)</version>
              </requireMavenVersion>
            </rules>
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>

      </plugins>

    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

      <plugin>
        <artifactId>quarkus-maven-plugin</artifactId>
        <groupId>io.quarkus.platform</groupId>
      </plugin>

      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

      <plugin>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <id>report-aggregate</id>
            <phase>verify</phase>
          </execution>
        </executions>
        <groupId>org.jacoco</groupId>
      </plugin>

      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>enforce</goal>
            </goals>
            <id>enforce-rules</id>
            <phase>validate</phase>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

    </plugins>
  </build>

  <dependencies>
    <dependency>
      <artifactId>lombok</artifactId>
      <groupId>org.projectlombok</groupId>
    </dependency>

    <dependency>
      <artifactId>junit-jupiter-api</artifactId>
      <groupId>org.junit.jupiter</groupId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <artifactId>jbh-commons-lib</artifactId>
        <groupId>com.jbh</groupId>
        <version>1.0.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <artifactId>jbh-preferences-domain</artifactId>
        <groupId>com.jbh</groupId>
        <version>1.0.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <artifactId>jbh-preferences-application</artifactId>
        <groupId>com.jbh</groupId>
        <version>1.0.0-SNAPSHOT</version>
      </dependency>

      <dependency>
        <artifactId>junit-platform-surefire-provider</artifactId>
        <groupId>org.junit.platform</groupId>
        <scope>test</scope>
        <version>1.1.0</version>
      </dependency>

      <dependency>
        <artifactId>junit-jupiter</artifactId>
        <groupId>org.junit.jupiter</groupId>
        <scope>test</scope>
      </dependency>

      <dependency>
        <artifactId>mockito-core</artifactId>
        <groupId>org.mockito</groupId>
        <scope>test</scope>
        <version>${mockito.version}</version>
      </dependency>

    </dependencies>

  </dependencyManagement>

  <modelVersion>4.0.0</modelVersion>

  <modules>
    <module>jbh-preferences-domain</module>
    <module>jbh-preferences-application</module>
    <module>jbh-preferences-infra</module>
  </modules>

  <packaging>pom</packaging>

  <parent>
    <artifactId>jbh-personal-finance</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <jacoco.branch.coverage.minimum>0.45</jacoco.branch.coverage.minimum>
    <jacoco.bundle.branch.minimum>0.40</jacoco.bundle.branch.minimum>
    <jacoco.bundle.line.minimum>0.63</jacoco.bundle.line.minimum>
    <jacoco.line.coverage.minimum>0.45</jacoco.line.coverage.minimum>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

</project>
