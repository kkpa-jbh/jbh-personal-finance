<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>jbh-finance-application</artifactId>
  <build>
    <plugins>
      
      <!-- JACOCO -->
      <plugin>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <id>prepare-agent</id>
          </execution>
          <execution>
            <goals>
              <goal>report</goal>
            </goals>
            <id>report</id>
            <phase>verify</phase>
          </execution>
          <execution>
            <configuration>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <excludes>
                    <exclude>com.jbh.finance.application.common.logging.*</exclude>
                    <exclude>com.jbh.finance.application.async.*</exclude>
                    <exclude>com.jbh.finance.application.exceptions.*</exclude>
                    <exclude>com.jbh.finance.application.feature.*.mappers.*</exclude>
                    <exclude>**/dto/**</exclude>
                    <exclude>**/vo/**</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <minimum>${jacoco.branch.coverage.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>BUNDLE</element>
                  <excludes>
                    <exclude>com.jbh.finance.application.common.logging.*</exclude>
                    <exclude>com.jbh.finance.application.async.*</exclude>
                    <exclude>com.jbh.finance.application.exceptions.*</exclude>
                    <exclude>com.jbh.finance.application.feature.*.mappers.*</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <minimum>${jacoco.bundle.line.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <minimum>${jacoco.bundle.branch.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
            <goals>
              <goal>check</goal>
            </goals>
            <id>jacoco-check</id>
            <phase>verify</phase>
          </execution>
        </executions>
        <groupId>org.jacoco</groupId>
      </plugin>

    </plugins>
  </build>

  <dependencies>

    <dependency>
      <artifactId>jbh-commons-lib</artifactId>
      <groupId>com.jbh</groupId>
    </dependency>

    <dependency>
      <artifactId>jbh-finance-domain</artifactId>
      <groupId>com.jbh</groupId>
    </dependency>


    <dependency>
      <artifactId>mockito-core</artifactId>
      <groupId>org.mockito</groupId>
      <scope>test</scope>
    </dependency>

    <!-- Logging Dependencies -->
    <!-- Only the API, no implementation -->
    <dependency>
      <artifactId>slf4j-api</artifactId>
      <groupId>org.slf4j</groupId>
    </dependency>

    <!-- SLF4J Implementation for tests -->
    <dependency>
      <artifactId>logback-classic</artifactId>
      <groupId>ch.qos.logback</groupId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <artifactId>archunit-junit5</artifactId>
      <groupId>com.tngtech.archunit</groupId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>
  <modelVersion>4.0.0</modelVersion>

  <packaging>jar</packaging>

  <parent>
    <artifactId>jbh-finance</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>


</project>