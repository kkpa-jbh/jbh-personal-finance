<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>jbh-account</artifactId>

  <build>

    <pluginManagement>
      <plugins>
        <!-- Compiler Plugin - EXTENDS parent configuration -->
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <artifactId>lombok</artifactId>
                <groupId>org.projectlombok</groupId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
        </plugin>

        <plugin>
          <artifactId>jacoco-maven-plugin</artifactId>
          <groupId>org.jacoco</groupId>
          <version>${maven.jacoco.plugin.version}</version>
        </plugin>

        <!-- Maven Enforcer Plugin for dependency management -->
        <plugin>
          <artifactId>maven-enforcer-plugin</artifactId>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven-enforcer-plugin.version}</version>
          <configuration>
            <rules>
              <!-- Ensure minimum Maven version -->
              <requireMavenVersion>
                <version>[3.8.1,)</version>
                <message>Maven 3.8.1 or higher is required for this project</message>
              </requireMavenVersion>
              
              <!-- Ensure minimum Java version -->
              <requireJavaVersion>
                <version>[21,)</version>
                <message>Java 21 or higher is required for this project</message>
              </requireJavaVersion>
              
              <!-- Prevent dependency convergence issues -->
              <dependencyConvergence />
              
              <!-- Ensure no duplicate dependencies -->
              <banDuplicatePomDependencyVersions />
              
              <!-- Ban specific vulnerable dependencies (example) -->
              <bannedDependencies>
                <excludes>
                  <exclude>log4j:log4j:*:jar:compile</exclude>
                  <exclude>commons-logging:commons-logging:*:jar:compile</exclude>
                </excludes>
                <message>These dependencies are banned due to security vulnerabilities or conflicts</message>
              </bannedDependencies>
            </rules>
          </configuration>
        </plugin>

      </plugins>

    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

      <plugin>
        <artifactId>quarkus-maven-plugin</artifactId>
        <groupId>io.quarkus.platform</groupId>
      </plugin>


      <!-- Surefire Plugin for Unit Tests -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

      <plugin>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <id>report-aggregate</id>
            <phase>verify</phase>
          </execution>
        </executions>
        <groupId>org.jacoco</groupId>
      </plugin>

      <!-- Maven Enforcer Plugin - runs during validate phase -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <dependencies>


    <dependency>
      <artifactId>lombok</artifactId>
      <groupId>org.projectlombok</groupId>
    </dependency>

    <dependency>
      <artifactId>junit-jupiter-api</artifactId>
      <groupId>org.junit.jupiter</groupId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <artifactId>jbh-account-domain</artifactId>
        <groupId>com.jbh</groupId>
        <version>1.0.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <artifactId>jbh-account-application</artifactId>
        <groupId>com.jbh</groupId>
        <version>1.0.0-SNAPSHOT</version>
      </dependency>

      <dependency>
        <artifactId>junit-platform-surefire-provider</artifactId>
        <groupId>org.junit.platform</groupId>
        <scope>test</scope>
        <version>1.1.0</version>
      </dependency>


      <!-- Tests -->
      <dependency>
        <artifactId>junit-jupiter</artifactId>
        <groupId>org.junit.jupiter</groupId>
        <scope>test</scope>
      </dependency>

      <dependency>
        <artifactId>mockito-core</artifactId>
        <groupId>org.mockito</groupId>
        <scope>test</scope>
        <version>${mockito.version}</version>
      </dependency>

    </dependencies>

  </dependencyManagement>

  <!-- Common dependencies for Module A and its children -->
  <modelVersion>4.0.0</modelVersion>

  <modules>
    <module>jbh-account-domain</module>
    <module>jbh-account-application</module>
    <module>jbh-account-infra</module>

  </modules>


  <packaging>pom</packaging>

  <parent>
    <artifactId>jbh-personal-finance</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    
    <!-- JaCoCo Coverage Thresholds -->
    <!-- Line Coverage: Percentage of code lines executed during tests -->
    <!-- Higher = more code paths tested, but doesn't guarantee quality -->
    <jacoco.line.coverage.minimum>0.60</jacoco.line.coverage.minimum>
    
    <!-- Branch Coverage: Percentage of decision branches (if/else) tested -->  
    <!-- More important than line coverage - ensures edge cases are tested -->
    <!-- Example: if(x>0) return "pos"; else return "neg" - both paths must be tested -->
    <jacoco.branch.coverage.minimum>0.50</jacoco.branch.coverage.minimum>
    
    <!-- Bundle Coverage: Overall module coverage (all classes combined) -->
    <!-- Prevents having few well-tested classes hide many untested ones -->
    <!-- Set slightly higher than class minimum to encourage broad coverage -->
    <jacoco.bundle.line.minimum>0.63</jacoco.bundle.line.minimum>
    <jacoco.bundle.branch.minimum>0.50</jacoco.bundle.branch.minimum>
  </properties>

</project>