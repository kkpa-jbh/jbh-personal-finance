<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>jbh-account</artifactId>
  <build>

    <pluginManagement>
      <plugins>
        <!-- Compiler Plugin - EXTENDS parent configuration -->
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <groupId>org.apache.maven.plugins</groupId>
        </plugin>

        <!-- Quarkus Plugin - EXTENDS parent configuration -->
        <plugin>
          <artifactId>quarkus-maven-plugin</artifactId>
          <configuration>
            <!-- INHERITS parent configuration (debug, suspend, executions) -->
            <!-- ADDS Module A specific configuration -->
            <environmentVariables>
              <MODULE_NAME>module-a</MODULE_NAME>
            </environmentVariables>
            <!-- Module A specific Quarkus settings -->
            <jvmArgs>-XX:+UseG1GC</jvmArgs>
          </configuration>
          <!-- Version and base config inherited from parent -->
          <groupId>io.quarkus.platform</groupId>
        </plugin>
      </plugins>

    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

      <plugin>
        <artifactId>quarkus-maven-plugin</artifactId>
        <groupId>io.quarkus.platform</groupId>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <artifactId>quarkus-arc</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <dependency>
      <artifactId>lombok</artifactId>
      <groupId>org.projectlombok</groupId>
    </dependency>

  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <artifactId>jbh-account-domain</artifactId>
        <groupId>com.jbh</groupId>
        <version>1.0.0-SNAPSHOT</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <modelVersion>4.0.0</modelVersion>

  <modules>
    <module>jbh-account-domain</module>
    <module>jbh-account-infra</module>
    <module>jbh-account-application</module>
  </modules>

  <packaging>pom</packaging>

  <!-- Common dependencies for Module A and its children -->
  <parent>
    <artifactId>jbh-personal-finance</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

</project>