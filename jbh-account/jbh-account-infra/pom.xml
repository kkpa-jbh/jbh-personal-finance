<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>jbh-account-infra</artifactId>
  <build>
    <plugins>

      <plugin>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <id>prepare-agent</id>
          </execution>
          <execution>
            <goals>
              <goal>report</goal>
            </goals>
            <id>report</id>
            <phase>verify</phase>
          </execution>
          <execution>
            <configuration>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <excludes>
                    <exclude>com.jbh.account.infra.common.logging.*</exclude>
                    <exclude>**/config/**</exclude>
                    <exclude>**/dto/**</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <minimum>${jacoco.branch.coverage.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>BUNDLE</element>
                  <excludes>
                    <exclude>com.jbh.account.infra.common.logging.*</exclude>
                    <exclude>**/config/**</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <minimum>${jacoco.bundle.line.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <minimum>${jacoco.bundle.branch.minimum}</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
            <goals>
              <goal>check</goal>
            </goals>
            <id>jacoco-check</id>
            <phase>verify</phase>
          </execution>
        </executions>
        <groupId>org.jacoco</groupId>
      </plugin>

      <!-- PMD Analysis -->
      <plugin>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/com/jbh/account/infra/common/logging/**/*.java</exclude>
          </excludes>
          <failOnViolation>${pmd.failOnViolation}</failOnViolation>
          <printFailingErrors>true</printFailingErrors>
          <rulesets>
            <ruleset>../pmd-ruleset-account.xml</ruleset>
          </rulesets>
          <targetJdk>${java.version}</targetJdk>
        </configuration>
        <groupId>org.apache.maven.plugins</groupId>
        <version>${maven-pmd-plugin.version}</version>
      </plugin>

      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>


      <!-- Jandex Plugin for CDI Bean Discovery -->
      <plugin>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>jandex</goal>
            </goals>
            <id>make-index</id>
          </execution>
        </executions>
        <groupId>io.smallrye</groupId>
      </plugin>

    </plugins>
  </build>

  <dependencies>

    <!-- JBH Dependencies -->
    <dependency>
      <artifactId>jbh-account-application</artifactId>
      <groupId>com.jbh</groupId>
    </dependency>

    <dependency>
      <artifactId>jbh-gateway-client</artifactId>
      <groupId>com.jbh</groupId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!-- JBH Dependencies -->

    <!-- Essential for file upload -->


    <!-- Essential for CDI/dependency injection -->
    <dependency>
      <artifactId>quarkus-arc</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <dependency>
      <artifactId>quarkus-rest</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>
    <!-- Add Jackson for JSON support -->
    <dependency>
      <artifactId>quarkus-rest-jackson</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <dependency>
      <artifactId>quarkus-smallrye-openapi</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <!-- Database Dependencies -->
    <dependency>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>
    <!-- https://mvnrepository.com/artifact/io.quarkiverse.hibernatetypes/quarkus-hibernate-types -->
    <dependency>
      <artifactId>quarkus-hibernate-types</artifactId>
      <groupId>io.quarkiverse.hibernatetypes</groupId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>
    <dependency>
      <artifactId>quarkus-liquibase</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <!-- Excel -->
    <dependency>
      <artifactId>poi</artifactId>
      <groupId>org.apache.poi</groupId>
      <version>${poi.version}</version>
    </dependency>

    <dependency>
      <artifactId>poi-ooxml</artifactId>
      <groupId>org.apache.poi</groupId>
      <version>${poi.version}</version>
    </dependency>

    <!-- https://mvnrepository.com/artifact/org.apache.poi/poi-ooxml-schemas -->
    <dependency>
      <artifactId>poi-ooxml-schemas</artifactId>
      <exclusions>
        <exclusion>
          <artifactId>xmlbeans</artifactId>
          <groupId>org.apache.xmlbeans</groupId>
        </exclusion>
      </exclusions>
      <groupId>org.apache.poi</groupId>
      <version>4.1.2</version>
    </dependency>


  </dependencies>
  <modelVersion>4.0.0</modelVersion>

  <packaging>jar</packaging>

  <parent>
    <artifactId>jbh-account</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <poi.version>5.4.1</poi.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

</project>