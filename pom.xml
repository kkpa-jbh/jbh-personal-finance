<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>jbh-personal-finance</artifactId>

  <build>
    <pluginManagement>
      <plugins>

        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <enablePreview>false</enablePreview>
            <parameters>true</parameters>
            <release>${maven.compiler.release}</release>
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>


        <!--Discover Tests & Generate reports (target/surefire-reports)  -->
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <useModulePath>true</useModulePath> <!-- Ensures compatibility with Java 9+ JPMS / module-info.java-->
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>

        <!-- Integration Tests *IT Classes -->
        <plugin>
          <artifactId>maven-failsafe-plugin</artifactId>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>

        <!-- Jandex for Quarkus CDI Annotation Indexing -->
        <plugin>
          <artifactId>jandex-maven-plugin</artifactId>
          <groupId>io.smallrye</groupId>
          <version>${jandex-plugin.version}</version>
        </plugin>

      </plugins>
    </pluginManagement>
  </build>

  <dependencyManagement>
    <dependencies>
      <!-- Quarkus BOM - Manages all Quarkus dependencies -->
      <dependency>
        <artifactId>quarkus-bom</artifactId>
        <groupId>io.quarkus.platform</groupId>
        <scope>import</scope>
        <type>pom</type>
        <version>${quarkus.version}</version>
      </dependency>

      <dependency>
        <artifactId>junit-bom</artifactId>
        <groupId>org.junit</groupId>
        <scope>import</scope> <!-- latest stable -->
        <type>pom</type>
        <version>${junit.version}</version>
      </dependency>

      <dependency>
        <artifactId>jbh-account-infra</artifactId>
        <groupId>com.jbh</groupId>
        <version>${project.version}</version>
      </dependency>


      <dependency>
        <artifactId>jbh-notification-infra</artifactId>
        <groupId>com.jbh</groupId>
        <version>${project.version}</version>
      </dependency>

      <!-- Lombok for boilerplate code reduction -->
      <dependency>
        <artifactId>lombok</artifactId>
        <groupId>org.projectlombok</groupId>
        <version>${lombok.version}</version>
      </dependency>

      <!-- Logging Dependencies -->
      <dependency>
        <artifactId>slf4j-api</artifactId>
        <groupId>org.slf4j</groupId>
        <version>${slf4j.version}</version>
      </dependency>

      <dependency>
        <artifactId>logback-classic</artifactId>
        <groupId>ch.qos.logback</groupId>
        <version>${logback.version}</version>
      </dependency>

      <dependency>
        <artifactId>logback-core</artifactId>
        <groupId>ch.qos.logback</groupId>
        <version>${logback.version}</version>
      </dependency>

    </dependencies>
  </dependencyManagement>
  <description>Multi-module personal finance management system</description>
  <groupId>com.jbh</groupId>
  <modelVersion>4.0.0</modelVersion>
  <!-- =============================================== -->
  <!-- PROPERTIES -->
  <!-- =============================================== -->
  <modules>
    <module>jbh-account</module>
    <module>jbh-notification</module>

    <!-- Assembly module last to ensure all dependencies are built -->
    <module>jbh-z-assembly</module>
  </modules>

  <!-- =============================================== -->
  <!-- MODULE DECLARATIONS -->
  <!-- =============================================== -->
  <name>JBH Personal Finance Platform</name>

  <!-- =============================================== -->
  <!-- DEPENDENCY MANAGEMENT -->
  <!-- Only actual JAR/WAR modules should be in dependencyManagement -->
  <!-- =============================================== -->
  <packaging>pom</packaging>

  <properties>
    <!-- Java & Encoding -->
    <jandex-plugin.version>3.1.2</jandex-plugin.version>
    <java.version>21</java.version>
    <junit.version>5.10.2</junit.version>
    <logback.version>1.5.6</logback.version>
    <lombok.version>1.18.30</lombok.version>
    <maven-compiler-plugin.version>3.12.1</maven-compiler-plugin.version>

    <!-- Test Maven Plugins -->
    <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <!-- External Libraries -->
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>

    <maven.jacoco.plugin.version>0.8.12</maven.jacoco.plugin.version>
    <mockito.version>5.10.0</mockito.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <quarkus.version>3.18.4</quarkus.version>
    <slf4j.version>2.0.13</slf4j.version>
    <testcontainers.version>1.19.5</testcontainers.version>
  </properties>


  <!-- =============================================== -->
  <!-- PLUGIN MANAGEMENT -->
  <!-- =============================================== -->
  <version>1.0.0-SNAPSHOT</version>
</project>